# TFT Meta Guide Environment Configuration
# Copy this file to .env and configure as needed

# Debug Mode
DEBUG=False

# API Keys (if needed for meta data sources)
# TACTICS_TOOLS_API_KEY=your_api_key_here
# METATFT_API_KEY=your_api_key_here

# Screen Capture Settings
CAPTURE_FPS=1
SCREEN_CAPTURE_DELAY=1000

# Overlay Settings
OVERLAY_WIDTH=500
OVERLAY_HEIGHT=800
OVERLAY_OPACITY=0.9

# OCR Engine (tesseract or easyocr)
OCR_ENGINE=easyocr

# Meta Data Update Interval (seconds)
META_UPDATE_INTERVAL=21600
